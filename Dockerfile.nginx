# Dockerfile for Nginx Reverse Proxy with Auto-Restart
# Uses dumb-init for proper signal handling
FROM nginx:1.25-alpine

# Install dumb-init for proper PID 1 signal handling
RUN apk add --no-cache dumb-init curl

# Copy SSL configuration
COPY nginx/snippets/ /etc/nginx/snippets/

# Copy site configs (will be overridden by environment-specific configs)
COPY nginx/conf.frontend /etc/nginx/conf.d/default.conf

# Create directories
RUN mkdir -p /var/www/html /var/log/nginx/custom

# Health check using nginx status
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Use dumb-init as PID 1 for proper signal forwarding
ENTRYPOINT ["dumb-init", "--"]

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]